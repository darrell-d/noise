# EC2 + Caddy HTTPS defaults. Copy to .env and replace the required values.
# Generate SECRET_KEY: openssl rand -hex 48
SECRET_KEY=
DEBUG=false
SITE_DOMAIN=noise.example.com
ACME_EMAIL=you@example.com
ALLOWED_HOSTS=noise.example.com
PUBLIC_URL=https://noise.example.com
CSRF_TRUSTED_ORIGINS=https://noise.example.com
SITE_TITLE=Noise
SITE_TAGLINE=There are no rules here
TIME_ZONE=UTC
WEB_CONCURRENCY=1
COOKIE_SECURE=true
SECURE_SSL_REDIRECT=true
TRUST_PROXY_HTTPS=true
TRACK_VISITS=false
NOISE_MAX_UPLOAD_BYTES=99614720

# Initial administrator: set a strong password, then remove it after first boot.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Default: SQLite + local uploads in the persistent Docker volume on EC2's EBS.
# Optional PostgreSQL/RDS: fill every connection value before setting DB_HOST.
DB_HOST=
DB_PORT=5432
DB_NAME=noise
DB_USER=noise
DB_PASSWORD=
DB_SSLMODE=verify-full
# Mounted in compose.aws.yaml. Needed only for PostgreSQL with verify-full.
PGSSLROOTCERT=/app/deploy/rds-global-bundle.pem

# Optional private S3 storage. Use the EC2 IAM role, not static AWS keys.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=

GOOGLE_MAPS_KEY=
NOISE_AUTH_COGNITO_DOMAIN=
NOISE_AUTH_COGNITO_CLIENT_ID=
NOISE_AUTH_COGNITO_USER_POOL_ID=
NOISE_AUTH_COGNITO_REGION=us-east-1
NOISE_AUTH_GOOGLE_PROVIDER=
NOISE_AUTH_FACEBOOK_PROVIDER=
NOISE_AUTH_INSTAGRAM_PROVIDER=
NOISE_AUTH_PHONE_ENABLED=false
