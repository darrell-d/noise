# Local defaults: copy to .env, or let ./install.sh create it for you.
# Generated by ./install.sh. Docker users must generate a unique value themselves.
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PUBLIC_URL=http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
PORT=8000
BIND_ADDRESS=127.0.0.1
SITE_TITLE=Noise
SITE_TAGLINE=There are no rules here
TIME_ZONE=UTC
WEB_CONCURRENCY=1
# Keep these false for local HTTP. Use .env.aws.example for public HTTPS hosting.
COOKIE_SECURE=false
SECURE_SSL_REDIRECT=false
TRUST_PROXY_HTTPS=false
TRACK_VISITS=false
NOISE_MAX_UPLOAD_BYTES=99614720

# Optional PostgreSQL; leave DB_HOST blank to use persistent local SQLite.
DB_HOST=
DB_PORT=5432
DB_NAME=noise
DB_USER=noise
DB_PASSWORD=
DB_SSLMODE=prefer

# Optional private S3 storage. Standard AWS credentials/role discovery applies.
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-1
AWS_S3_ENDPOINT_URL=

# Optional reverse geocoding; coordinates work without a Google API key.
GOOGLE_MAPS_KEY=

# Optional Cognito social login. Local username/password login always works.
NOISE_AUTH_COGNITO_DOMAIN=
NOISE_AUTH_COGNITO_CLIENT_ID=
NOISE_AUTH_COGNITO_USER_POOL_ID=
NOISE_AUTH_COGNITO_REGION=us-east-1
NOISE_AUTH_GOOGLE_PROVIDER=
NOISE_AUTH_FACEBOOK_PROVIDER=
NOISE_AUTH_INSTAGRAM_PROVIDER=
NOISE_AUTH_PHONE_ENABLED=false

# Optional unattended first install; otherwise install.sh asks interactively.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=
